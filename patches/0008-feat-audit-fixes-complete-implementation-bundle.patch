+++    prompt.includes('rate') || prompt.includes('نرخ') || prompt.includes('nonce') || prompt.includes('نانس') ||
+++    prompt.includes('csp') || prompt.includes('حمله') || prompt.includes('inject') || prompt.includes('تزریق');
