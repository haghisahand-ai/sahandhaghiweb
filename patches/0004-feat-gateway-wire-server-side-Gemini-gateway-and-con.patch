+/**
+ * Closed-form analytical evaluation of a point along a cubic Bézier curve at progress t in [0, 1].
+ * O(1) mathematical execution with zero DOM layout thrashing.
+ */
+export function evaluateBezierPoint(
+  x1: number,
+  y1: number,
+  x2: number,
+  y2: number,
+  t: number,
+  curvature: number = 0.45
+): { x: number; y: number } {
+  const clampedT = Math.max(0, Math.min(1, t));
+  const dx = (x2 - x1) * curvature;
+  const cx1 = x1 + dx;
+  const cy1 = y1;
+  const cx2 = x2 - dx;
+  const cy2 = y2;
+
+  const oneMinusT = 1 - clampedT;
+  const oneMinusT2 = oneMinusT * oneMinusT;
+  const oneMinusT3 = oneMinusT2 * oneMinusT;
+  const t2 = clampedT * clampedT;
+  const t3 = t2 * clampedT;
+
+  const x = oneMinusT3 * x1 + 3 * oneMinusT2 * clampedT * cx1 + 3 * oneMinusT * t2 * cx2 + t3 * x2;
+  const y = oneMinusT3 * y1 + 3 * oneMinusT2 * clampedT * cy1 + 3 * oneMinusT * t2 * cy2 + t3 * y2;
+
+  return { x: Number(x.toFixed(2)), y: Number(y.toFixed(2)) };
+}
+
+/**
+ * Analytical evaluation of a point along an orthogonal conduit at progress t in [0, 1].
+ */
+export function evaluateOrthogonalPoint(
+  x1: number,
+  y1: number,
+  x2: number,
+  y2: number,
+  t: number,
+  midRatio: number = 0.45
+): { x: number; y: number } {
+  const clampedT = Math.max(0, Math.min(1, t));
+  const midX = x1 + (x2 - x1) * midRatio;
+
+  const len1 = Math.abs(midX - x1);
+  const len2 = Math.abs(y2 - y1);
+  const len3 = Math.abs(x2 - midX);
+  const totalLen = len1 + len2 + len3 || 1;
+
+  const dist = clampedT * totalLen;
+
+  if (dist <= len1) {
+    const subT = len1 === 0 ? 0 : dist / len1;
+    return { x: Number((x1 + (midX - x1) * subT).toFixed(2)), y: Number(y1.toFixed(2)) };
+  } else if (dist <= len1 + len2) {
+    const subT = len2 === 0 ? 0 : (dist - len1) / len2;
+    return { x: Number(midX.toFixed(2)), y: Number((y1 + (y2 - y1) * subT).toFixed(2)) };
+  } else {
+    const subT = len3 === 0 ? 0 : (dist - len1 - len2) / len3;
+    return { x: Number((midX + (x2 - midX) * subT).toFixed(2)), y: Number(y2.toFixed(2)) };
+  }
+}
