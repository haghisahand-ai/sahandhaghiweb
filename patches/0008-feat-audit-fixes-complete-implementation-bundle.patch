++
++        if (defined('DOING_AUTOSAVE') && DOING_AUTOSAVE) {
++            return;
++        }
++
++        if (isset($_POST['sahand_seo_title'])) {
++            update_post_meta($post_id, '_sahand_seo_title', sanitize_text_field(wp_unslash($_POST['sahand_seo_title'])));
