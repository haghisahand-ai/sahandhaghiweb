+        </div>
+      </div>
+    </div>
+
+  </div>
+</main>
+
+<script>
+document.addEventListener('DOMContentLoaded', function() {
+  const form = document.getElementById('sahand-contact-form');
+  const alertBox = document.getElementById('contact-alert');
+  const submitBtn = document.getElementById('contact-submit-btn');
+
+  if (!form) return;
+
+  form.addEventListener('submit', async function(e) {
+    e.preventDefault();
+
+    const name = document.getElementById('contact-name').value.trim();
+    const email = document.getElementById('contact-email').value.trim();
+    const message = document.getElementById('contact-message').value.trim();
+    const nonce = document.getElementById('contact-nonce').value;
+    const hp = document.getElementById('contact-hp').value;
+
+    // Client-side quick check
+    if (!name || !email || !message || message.length < 5) {
+      showAlert('error', '<?php echo esc_js(__('Please fill out all required fields with a message of at least 5 characters.', 'sahand-theme')); ?>');
+      return;
+    }
+
+    submitBtn.disabled = true;
+    submitBtn.textContent = '<?php echo esc_js(__('Transmitting...', 'sahand-theme')); ?>';
+
+    try {
+      const response = await fetch('<?php echo esc_url(rest_url('sahand/v1/contact')); ?>', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+          'X-WP-Nonce': nonce
+        },
+        body: JSON.stringify({
+          name: name,
+          email: email,
+          message: message,
+          _wpnonce: nonce,
+          _sahand_hp: hp
+        })
+      });
+
+      const data = await response.json();
+
+      if (response.ok && data.success) {
+        showAlert('success', data.message || '<?php echo esc_js(__('Your message has been delivered.', 'sahand-theme')); ?>');
+        form.reset();
+      } else {
+        const errorMsg = data.message || ('<?php echo esc_js(__('Submission failed with status', 'sahand-theme')); ?> ' + response.status);
+        showAlert('error', errorMsg);
+      }
+    } catch (err) {
+      showAlert('error', '<?php echo esc_js(__('Network communication error. Please check your connection or contact via direct email.', 'sahand-theme')); ?>');
+    } finally {
+      submitBtn.disabled = false;
+      submitBtn.textContent = '<?php echo esc_js(__('Send Message', 'sahand-theme')); ?> →';
+    }
+  });
+
+  function showAlert(type, message) {
+    alertBox.style.display = 'block';
+    if (type === 'success') {
+      alertBox.style.background = 'rgba(16, 185, 129, 0.1)';
+      alertBox.style.border = '1px solid #10B981';
+      alertBox.style.color = '#065F46';
+    } else {
+      alertBox.style.background = 'rgba(239, 68, 68, 0.1)';
+      alertBox.style.border = '1px solid #EF4444';
+      alertBox.style.color = '#991B1B';
+    }
+    alertBox.textContent = message;
+    alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+  }
+});
+</script>
+
+<?php
+get_footer();
