+  if (!form) return;
+
+  form.addEventListener('submit', async function(e) {
+    e.preventDefault();
+    const prompt = input.value.trim();
+    if (!prompt) return;
+
+    submitBtn.disabled = true;
+    statusIndicator.textContent = 'STATUS: INFERENCE IN PROGRESS...';
+    statusIndicator.style.color = '#38BDF8';
+
+    try {
+      const response = await fetch('/wp-json/sahand/v1/ai/generate', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ prompt: prompt, language: '<?php echo esc_js($current_lang); ?>' })
+      });
+
+      const data = await response.json();
+      container.style.display = 'block';
+
+      if (response.ok && data.success) {
+        textElem.textContent = data.text;
+        latencyElem.textContent = 'LATENCY: ' + (data.latency_ms || '--') + 'ms';
+        statusIndicator.textContent = 'STATUS: COMPLETE (200 OK)';
+        statusIndicator.style.color = '#10B981';
+      } else {
+        textElem.textContent = 'Error: ' + (data.error || 'Request failed with HTTP ' + response.status);
+        statusIndicator.textContent = 'STATUS: ERROR (' + response.status + ')';
+        statusIndicator.style.color = '#EF4444';
+      }
+    } catch (err) {
+      container.style.display = 'block';
+      textElem.textContent = 'Network or client error: ' + err.message;
+      statusIndicator.textContent = 'STATUS: CONNECTION ERROR';
+      statusIndicator.style.color = '#EF4444';
+    } finally {
+      submitBtn.disabled = false;
+    }
+  });
+});
+</script>
