++License: GNU General Public License v2 or later
++License URI: http://www.gnu.org/licenses/gpl-2.0.html
++Text Domain: sahand-theme
++Domain Path: /languages
++Tags: block-styles, custom-menu, featured-images, full-site-editing, rtl-language-support, translation-ready
++*/
++
++/* ==========================================================================
++   DESIGN TOKENS & SYSTEM VARIABLES
++   ========================================================================== */
++:root {
++  /* Surface & Canvas Tokens */
++  --color-canvas: #FAFAFB;
++  --color-canvas-dark: #0A0E17;
++  --color-canvas-obsidian: #070A11;
++  --color-surface: #FFFFFF;
++  --color-surface-dark: #0F1626;
++  --color-surface-subtle: #F3F4F6;
++  --color-border-subtle: #E5E7EB;
++  --color-border-dark: rgba(255, 255, 255, 0.08);
++  --color-border-strong: #D1D5DB;
++
++  /* Typography Colors (WCAG AAA/AA Compliant) */
++  --color-text-primary: #111827;
++  --color-text-primary-dark: #FFFFFF;
++  --color-text-secondary: #4B5563;
++  --color-text-secondary-dark: #94A3B8;
++  --color-text-muted: #6B7280;
++
++  /* Accent & Status */
++  --color-accent: #0284C7;
++  --color-accent-hover: #0369A1;
++  --color-accent-electric: #38BDF8;
++  --color-accent-cyan: #00F2FE;
++  --color-accent-subtle: rgba(2, 132, 199, 0.08);
++  --color-success: #059669;
++  --color-warning: #D97706;
++  --color-danger: #DC2626;
++
++  /* Typography Stacks */
++  --font-persian: 'Vazirmatn', -apple-system, BlinkMacSystemFont, 'Segoe UI', Tahoma, sans-serif;
++  --font-latin: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
++  --font-mono: 'JetBrains Mono', 'Fira Code', ui-monospace, SFMono-Regular, monospace;
++
++  /* Layout Rhythm */
++  --container-max: 1200px;
++  --container-narrow: 820px;
++  --radius-sm: 4px;
++  --radius-md: 8px;
++  --radius-lg: 12px;
++  --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
++  --transition-normal: 250ms cubic-bezier(0.4, 0, 0.2, 1);
++}
++
++/* Base Reset & Semantic Defaults */
++*, *::before, *::after {
++  box-sizing: border-box;
++  margin: 0;
++  padding: 0;
++}
++
++html {
++  font-size: 16px;
++  -webkit-text-size-adjust: 100%;
++  scroll-behavior: smooth;
++}
++
++body {
++  background-color: var(--color-canvas);
++  color: var(--color-text-primary);
++  font-family: var(--font-latin);
++  font-weight: 400;
++  line-height: 1.6;
++  text-rendering: optimizeLegibility;
++  -webkit-font-smoothing: antialiased;
++}
++
++/* Persian Font Override when dir="rtl" */
++[dir="rtl"] body,
++body.rtl {
++  font-family: var(--font-persian);
++}
++
++/* Accessibility: Focus Rings */
++:focus-visible {
++  outline: 2px solid var(--color-accent);
++  outline-offset: 2px;
++}
++
++/* Logical Layout Containers */
++.sahand-container {
++  width: 100%;
++  max-width: var(--container-max);
++  margin-inline: auto;
++  padding-inline: 1.5rem;
++}
++
++.sahand-container-narrow {
++  width: 100%;
++  max-width: var(--container-narrow);
++  margin-inline: auto;
++  padding-inline: 1.5rem;
++}
++
++/* Reusable Header & Navigation */
++.site-header {
++  position: sticky;
++  top: 0;
++  z-index: 100;
++  background-color: rgba(255, 255, 255, 0.92);
++  backdrop-filter: blur(8px);
++  border-bottom: 1px solid var(--color-border-subtle);
++  transition: border-color var(--transition-fast);
++}
++
++.site-header-inner {
++  display: flex;
++  align-items: center;
++  justify-content: space-between;
++  height: 4.25rem;
++}
++
++.site-branding {
++  display: flex;
++  align-items: center;
++  gap: 0.75rem;
++  text-decoration: none;
++  color: var(--color-text-primary);
++}
++
++.site-monogram {
++  width: 2.25rem;
++  height: 2.25rem;
++  border-radius: var(--radius-sm);
++  background: var(--color-text-primary);
++  color: #FFFFFF;
++  display: flex;
++  align-items: center;
++  justify-content: center;
++  font-family: var(--font-mono);
++  font-weight: 700;
++  font-size: 0.8125rem;
++  letter-spacing: 0.05em;
++}
++
++.site-title {
++  font-family: var(--font-mono);
++  font-weight: 700;
++  font-size: 1rem;
++  letter-spacing: 0.15em;
++  text-transform: uppercase;
++}
++
++/* Navigation List */
++.site-nav ul {
++  display: flex;
++  list-style: none;
++  gap: 0.5rem;
++}
++
++.site-nav a {
++  display: inline-block;
++  padding: 0.4rem 0.75rem;
++  font-size: 0.875rem;
++  font-weight: 500;
++  color: var(--color-text-secondary);
++  text-decoration: none;
++  border-radius: var(--radius-sm);
++  transition: all var(--transition-fast);
++}
++
++.site-nav a:hover,
++.site-nav a[aria-current="page"] {
++  color: var(--color-accent);
++  background-color: var(--color-accent-subtle);
++}
++
++/* Language Switcher Component */
++.lang-switcher {
++  display: flex;
++  align-items: center;
++  background-color: var(--color-surface-subtle);
++  border: 1px solid var(--color-border-subtle);
++  border-radius: var(--radius-md);
++  padding: 0.2rem;
++  gap: 0.2rem;
++}
++
++.lang-switcher a {
++  padding: 0.25rem 0.6rem;
++  font-size: 0.75rem;
++  font-weight: 600;
++  text-decoration: none;
++  color: var(--color-text-muted);
++  border-radius: calc(var(--radius-md) - 2px);
++  transition: all var(--transition-fast);
++}
++
++.lang-switcher a.current-lang {
++  background-color: var(--color-surface);
++  color: var(--color-accent);
++  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
++}
++
++/* Editorial Cards */
++.sahand-card {
++  background-color: var(--color-surface);
++  border: 1px solid var(--color-border-subtle);
++  border-radius: var(--radius-md);
++  padding: 1.75rem;
++  transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
++}
++
++.sahand-card:hover {
++  border-color: var(--color-border-strong);
++  box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
++}
++
++/* Badges */
++.badge {
++  display: inline-flex;
++  align-items: center;
++  gap: 0.35rem;
++  padding: 0.25rem 0.5rem;
++  border-radius: var(--radius-sm);
++  font-family: var(--font-mono);
++  font-size: 0.6875rem;
++  font-weight: 600;
++  text-transform: uppercase;
++  letter-spacing: 0.05em;
++}
++
++.badge-tech {
++  background-color: var(--color-surface-subtle);
++  color: var(--color-text-secondary);
++  border: 1px solid var(--color-border-subtle);
++}
++
++.badge-stable {
++  background-color: rgba(5, 150, 105, 0.1);
++  color: var(--color-success);
++  border: 1px solid rgba(5, 150, 105, 0.2);
++}
++
++/* Neural Network & Engineering Data-Flow SVG Animations */
++@keyframes neuralFlowForward {
++  from { stroke-dashoffset: 240; }
++  to { stroke-dashoffset: 0; }
++}
++
++@keyframes neuralPulseGlow {
++  0%, 100% { opacity: 0.35; transform: scale(1); }
++  50% { opacity: 0.85; transform: scale(1.15); }
++}
++
++.synapse-packet-anim {
++  animation: neuralFlowForward var(--flow-duration, 5s) linear infinite;
++  animation-delay: var(--flow-delay, 0s);
++}
++
++.node-pulse-anim {
++  animation: neuralPulseGlow var(--pulse-duration, 4s) ease-in-out infinite;
++  transform-origin: center;
++}
++
++/* Accessible Reduced Motion Fallback */
++@media (prefers-reduced-motion: reduce) {
++  *, *::before, *::after {
++    animation-duration: 0.01ms !important;
++    animation-iteration-count: 1 !important;
++    transition-duration: 0.01ms !important;
++    scroll-behavior: auto !important;
++  }
++  .synapse-packet-anim, .node-pulse-anim {
++    animation: none !important;
++  }
++}
++
